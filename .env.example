# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Where intake submissions go -------------------------------------------
# API key from https://resend.com (free tier covers early volume).
RESEND_API_KEY=
# The inbox that receives completed intake forms.
INTAKE_TO_EMAIL=theadminreset44@gmail.com
# Verified sender address. Until a domain is verified with Resend, their
# shared testing sender works: onboarding@resend.dev
INTAKE_FROM_EMAIL=onboarding@resend.dev

# --- Booking ---------------------------------------------------------------
# Calendly (or any booking) link shown after the form is submitted.
# Without it the confirmation screen falls back to an email link.
NEXT_PUBLIC_CALENDLY_URL=
